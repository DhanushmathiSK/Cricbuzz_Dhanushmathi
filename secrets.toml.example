# Copy this file to secrets.toml and fill in your values. Never commit secrets.toml.
RAPIDAPI_KEY = "paste-your-rapidapi-key-here"

# Optional: another database (default is a local SQLite file, cricket.db)
# DATABASE_URL = "postgresql://user:password@localhost:5432/cricket"
# DATABASE_URL = "mysql://user:password@localhost:3306/cricket"

# Optional: only if RapidAPI shows a different host for your subscription
# RAPIDAPI_HOST = "cricbuzz-cricket.p.rapidapi.com"
